#!/usr/bin/env node
// simsites — use SimSites from any repo: simulate a feature first, then let Claude Code build it.
// No dependencies (Node 20+ recommended, 18 works). Talks to the hosted SimSites over HTTP; captures your app and verifies the build here,
// with Playwright (installed into ~/.simsites/runner the first time it's needed).

import { execFileSync, spawn } from "node:child_process";
import { createHash } from "node:crypto";
import { chmodSync, existsSync, mkdirSync, readFileSync, realpathSync, rmSync, writeFileSync, readdirSync, statSync } from "node:fs";
import { homedir, hostname } from "node:os";
import path from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const HOME_DIR = path.join(homedir(), ".simsites");
const HOME_CONFIG = path.join(HOME_DIR, "config.json");

if (Number(process.versions.node.split(".")[0]) < 18) {
  console.error(`simsites needs Node.js 20 or newer (this is ${process.version}). Install it from https://nodejs.org, then try again.`);
  process.exit(1);
}

// Behind a proxy (HTTPS_PROXY), Node's fetch only uses it when told to: run again, told so — the dev server on this
// machine still goes direct.
const proxied = process.env.HTTPS_PROXY || process.env.https_proxy || process.env.HTTP_PROXY || process.env.http_proxy;
if (proxied && !process.env.NODE_USE_ENV_PROXY && !process.env.SIMSITES_NO_PROXY_RERUN) {
  const { spawnSync } = await import("node:child_process");
  const noProxy = [process.env.NO_PROXY || process.env.no_proxy, "localhost", "127.0.0.1", "::1"].filter(Boolean).join(",");
  const r = spawnSync(process.execPath, ["--no-warnings", ...process.execArgv, fileURLToPath(import.meta.url), ...process.argv.slice(2)], {
    stdio: "inherit",
    env: { ...process.env, NODE_USE_ENV_PROXY: "1", NO_PROXY: noProxy, no_proxy: noProxy, SIMSITES_NO_PROXY_RERUN: "1" },
  });
  process.exit(r.status ?? 1);
}

// ---- args ------------------------------------------------------------------------------------

const argv = process.argv.slice(2);
const flags = {};
const SWITCHES = new Set(["json", "all", "drafts", "watch", "help", "replace", "term", "video", "no-open", "gif", "phone", "labels", "watch-only"]);
const pos = [];
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a.startsWith("--")) {
    const [k, v] = a.slice(2).split("=");
    if (v !== undefined) flags[k] = v;
    // On/off flags never take a value: `simsites design --json "the feature"` keeps the feature as an argument.
    else if (!SWITCHES.has(k) && argv[i + 1] && !argv[i + 1].startsWith("--")) flags[k] = argv[++i];
    else flags[k] = true;
  } else pos.push(a);
}
const cmd = pos.shift() || "help";
const JSON_OUT = !!flags.json;

// ---- output ----------------------------------------------------------------------------------

const c = process.stdout.isTTY && !process.env.NO_COLOR
  ? { dim: (s) => `\x1b[2m${s}\x1b[0m`, bold: (s) => `\x1b[1m${s}\x1b[0m`, green: (s) => `\x1b[32m${s}\x1b[0m`, red: (s) => `\x1b[31m${s}\x1b[0m`, yellow: (s) => `\x1b[33m${s}\x1b[0m`, blue: (s) => `\x1b[34m${s}\x1b[0m` }
  : { dim: (s) => s, bold: (s) => s, green: (s) => s, red: (s) => s, yellow: (s) => s, blue: (s) => s };
const out = (s = "") => process.stdout.write(s + "\n");
/** Progress for long waits: on stderr, so `--json` stdout stays parseable and Claude Code still sees it. */
const progress = (s) => process.stderr.write(`${new Date().toTimeString().slice(0, 8)} ${s}\n`);
function fail(msg, code = 1) {
  if (JSON_OUT) out(JSON.stringify({ error: msg }));
  else process.stderr.write(c.red("✗ ") + msg + "\n");
  reportRun(false, msg);
  process.exit(code);
}

/*
 * How the CLI does on people's computers: each command's outcome (and the error, when it failed) goes to SimSites,
 * which logs it to Sentry (docs/observability.md). Sent by a detached process, so it never slows a command down or
 * keeps it alive. Only to a hosted SimSites this computer is signed in to; never file contents or code.
 * SIMSITES_TELEMETRY=0 turns it off.
 */
const STARTED = Date.now();
const QUIET_COMMANDS = new Set(["hook", "help", "version", "auth"]);
let reported = false;
function reportRun(ok, error) {
  if (reported || QUIET_COMMANDS.has(cmd) || process.env.SIMSITES_TELEMETRY === "0") return;
  reported = true;
  try {
    const token = studioToken();
    // A local Studio (http://localhost, developing SimSites) isn't told, unless SIMSITES_TELEMETRY=1 (the tests).
    if (!token || (!/^https:\/\//.test(studioUrl()) && process.env.SIMSITES_TELEMETRY !== "1")) return;
    let engine = false;
    try {
      engine = !!engineReady; // not yet declared when a command fails while the CLI starts
    } catch {}
    const event = {
      command: cmd,
      ok,
      ms: Date.now() - STARTED,
      ...(error ? { error: String(error).slice(0, 1000) } : {}),
      version: readJson(path.join(PLUGIN_DIR, ".claude-plugin", "plugin.json"), {}).version ?? null,
      os: process.platform,
      arch: process.arch,
      node: process.version,
      engine,
      feature: flags.project || repoConfig()?.current || null,
    };
    const script = `fetch(process.env.U,{method:"POST",headers:{"content-type":"application/json",authorization:"Bearer "+process.env.T},body:process.env.E,signal:AbortSignal.timeout(8000)}).catch(()=>{})`;
    spawn(process.execPath, ["-e", script], {
      detached: true,
      stdio: "ignore",
      env: { ...process.env, U: `${studioUrl()}/api/cli/event`, T: token, E: JSON.stringify(event) },
    }).unref();
  } catch {}
}

// ---- config ----------------------------------------------------------------------------------

const readJson = (f, fb) => {
  try {
    return JSON.parse(readFileSync(f, "utf8"));
  } catch {
    return fb;
  }
};
const homeConfig = () => readJson(HOME_CONFIG, {});
function saveHome(patch) {
  mkdirSync(HOME_DIR, { recursive: true });
  writeFileSync(HOME_CONFIG, JSON.stringify({ ...homeConfig(), ...patch }, null, 2) + "\n");
}
/** The hosted SimSites. SIMSITES_URL or `simsites auth --url` point the CLI elsewhere (a test or development server). */
const DEFAULT_URL = "https://simsites.vercel.app";
const studioUrl = () => (process.env.SIMSITES_URL || homeConfig().studioUrl || DEFAULT_URL).replace(/\/+$/, "");
const PLUGIN_DIR = path.dirname(path.dirname(fileURLToPath(import.meta.url)));

/*
 * Plugin skills always show as /<plugin>:<skill> (here /simsites:simsites). A personal skill isn't prefixed, so this
 * one gives people a plain /simsites that hands over to the plugin's skill. Written by `auth` and `setup`; a skill of
 * that name the person wrote themselves is left alone.
 */
const SHORTCUT_MARK = "<!-- simsites shortcut -->";
function installShortcut() {
  const file = path.join(homedir(), ".claude", "skills", "simsites", "SKILL.md");
  if (existsSync(file) && !readFileSync(file, "utf8").includes(SHORTCUT_MARK)) return false;
  mkdirSync(path.dirname(file), { recursive: true });
  writeFileSync(
    file,
    `---
name: simsites
description: SimSites — design a UI feature as short simulations of the app before building it (shortcut for /simsites:simsites).
argument-hint: <the feature you want, in plain words>
disable-model-invocation: true
---
${SHORTCUT_MARK}
Use the Skill tool to run the \`simsites:simsites\` skill with these arguments, then follow it: $ARGUMENTS
`,
  );
  return true;
}

// The token for a hosted SimSites (`simsites auth <token>`), per Studio URL; a local Studio needs none.
const CREDENTIALS = path.join(HOME_DIR, "credentials.json");
const studioToken = () => process.env.SIMSITES_TOKEN || readJson(CREDENTIALS, {})[studioUrl()] || null;
/** fetch to the Studio, with the token when there is one. */
function studioFetch(p, init = {}) {
  const token = studioToken();
  return fetch(studioUrl() + p, { ...init, headers: { ...(init.headers ?? {}), ...(token ? { authorization: `Bearer ${token}` } : {}) } });
}

function repoRoot() {
  try {
    return execFileSync("git", ["rev-parse", "--show-toplevel"], { stdio: ["ignore", "pipe", "ignore"] }).toString().trim();
  } catch {
    return process.cwd();
  }
}
const ROOT = flags.repo ? path.resolve(String(flags.repo)) : repoRoot();
const REPO_CONFIG = path.join(ROOT, ".simsites", "config.json");
const repoConfig = () => readJson(REPO_CONFIG, null);
function saveRepo(patch) {
  mkdirSync(path.dirname(REPO_CONFIG), { recursive: true });
  writeFileSync(REPO_CONFIG, JSON.stringify({ ...(repoConfig() ?? {}), ...patch }, null, 2) + "\n");
}
function currentProject() {
  const p = flags.project || repoConfig()?.current;
  if (!p) fail("No feature yet in this repo. Start one with /simsites in Claude Code (simsites design \"<what you want to build>\").");
  return String(p);
}

// ---- http ------------------------------------------------------------------------------------

// ---- the engine: browser work on this machine, when the hosted SimSites has no render worker ----------------------
// It says so in /api/health ("cli-engine"). Then the requests below run here: the Studio's own route handlers, bundled
// in ../engine/engine.mjs, on the repo's design folder. Before, the feature's state comes from SimSites (approvals and
// comments happen on its watch page); after, what changed goes back (GET/POST /api/projects/<id>/engine, lib/sync.ts).
const ENGINE_DIR = path.join(PLUGIN_DIR, "engine");
const ENGINE_LOCAL = new Set(["look", "undo", "gif", "zoom", "labels"]);
const FEATURE_ID = "([a-z0-9][a-z0-9-]{0,63})";

async function usesEngine() {
  return !!(await health())?.features?.includes("cli-engine");
}

/** Which requests the engine runs here: rendering, checking, drawing on scenes, the hand-off. */
function engineRequest(method, p, body) {
  const u = new URL(p, "http://x");
  let m = u.pathname.match(new RegExp(`^/api/projects/${FEATURE_ID}/console$`));
  if (m && method === "POST" && ENGINE_LOCAL.has(body?.action)) return m[1];
  m = u.pathname.match(new RegExp(`^/api/projects/${FEATURE_ID}/sims/[a-z0-9][a-z0-9-]{0,63}/(check|ansi)$`));
  if (m && method === "GET") return m[1];
  m = u.pathname.match(new RegExp(`^/api/projects/${FEATURE_ID}/handoff$`));
  if (m && method === "POST") return m[1];
  return null;
}

let engineReady;
function loadEngine(workspace) {
  engineReady ??= (async () => {
    globalThis.__simsitesPlaywright = await loadPlaywright();
    // The engine always runs locally: on the design folder, never on a database.
    process.env.SIMSITES_WORKSPACE = workspace;
    process.env.SIMSITES_RUNTIME = path.join(ENGINE_DIR, "sim.js");
    for (const k of ["DATABASE_URL", "NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY", "NEXT_PUBLIC_SUPABASE_ANON_KEY", "SUPABASE_SECRET_KEY"]) delete process.env[k];
    const engine = await import(pathToFileURL(path.join(ENGINE_DIR, "engine.mjs")).href);
    const server = await engine.serve(path.join(ENGINE_DIR, "sim.js"));
    // Where the engine's browser loads scenes from (lib/scene-url.ts); SIMSITES_URL stays the hosted SimSites.
    process.env.SIMSITES_ENGINE_URL = server.url;
    return { engine, server };
  })();
  return engineReady;
}

const ENGINE_DOCS = ["plan.json", "decisions.json", "build-progress.json", "references/capture.json", "coverage-scan.json", "coverage-decisions.json", "fixes.json", "verify/report.json"];
const sameJson = (a, b) => JSON.stringify(a ?? null) === JSON.stringify(b ?? null);
const readLines = (f) => (existsSync(f) ? readFileSync(f, "utf8").split("\n").filter(Boolean).map((l) => JSON.parse(l)) : []);
const writeJsonFile = (f, v) => {
  mkdirSync(path.dirname(f), { recursive: true });
  writeFileSync(f, JSON.stringify(v, null, 2) + "\n");
};

/** The design folder's files SimSites keeps (scenes, looks, references, style), with their sizes. */
function engineFiles(dir) {
  const found = {};
  for (const rel of walkFiles(dir))
    if (/^(sims|references|style)\/|^[\w.-]+\.(md|html|css)$/.test(rel) && !LOCAL_ONLY.test(rel) && !rel.split("/").some((part) => part.startsWith(".")) && !/^sims\/[^/]+\/(meta\.json|chat\.jsonl)$/.test(rel) && !ENGINE_DOCS.includes(rel) && rel !== "brief.md")
      found[rel] = statSync(path.join(dir, rel)).size;
  return found;
}

/** Before the engine runs: SimSites' state into the design folder (the feature, approvals, comments, history, documents). */
function pullState(dir, state) {
  // The feature as a local Studio knows it, with this repo as its repo (the hand-off is written into it).
  writeJsonFile(path.join(dir, "project.json"), { ...state.project, repo: { ...(state.project.repo ?? {}), path: ROOT, devUrl: repoConfig()?.devUrl ?? state.project.repo?.devUrl ?? "" } });
  if (state.brief) writeFileSync(path.join(dir, "brief.md"), state.brief);
  if (!existsSync(path.join(dir, "usecases.json")) && state.useCases.length) writeJsonFile(path.join(dir, "usecases.json"), state.useCases);
  for (const uc of state.useCases) {
    const sim = path.join(dir, "sims", uc.id);
    if (state.metas[uc.id]) writeJsonFile(path.join(sim, "meta.json"), state.metas[uc.id]);
    const chat = state.chats[uc.id] ?? [];
    mkdirSync(sim, { recursive: true });
    writeFileSync(path.join(sim, "chat.jsonl"), chat.map((e) => JSON.stringify(e)).join("\n") + (chat.length ? "\n" : ""));
  }
  writeJsonFile(path.join(dir, "inbox.json"), state.inbox);
  for (const [name, value] of Object.entries(state.docs)) writeJsonFile(path.join(dir, name), value);
}

/** After: only what this run changed, so a comment or an approval made meanwhile on the watch page stays. */
async function pushState(p, dir, state) {
  const useCases = readJson(path.join(dir, "usecases.json"), []);
  const ids = useCases.map((u) => u.id);
  const body = { scenes: ids.filter((id) => existsSync(path.join(dir, "sims", id, "scene.html"))), metas: {}, chat: {}, inboxClosed: [], docs: {} };
  const hosted = Object.fromEntries(state.useCases.map((u) => [u.id, u]));
  if (useCases.length && (useCases.length !== state.useCases.length || useCases.some((u) => !sameJson({ ...hosted[u.id], ...u }, hosted[u.id])))) body.useCases = useCases;
  for (const id of ids) {
    const meta = readJson(path.join(dir, "sims", id, "meta.json"), null);
    const before = state.metas[id] ?? {};
    if (meta)
      for (const k of ["status", "versions", "approvedBy", "takes", "keptTake", "error"])
        if (k in meta && !sameJson(meta[k], before[k])) (body.metas[id] ??= {})[k] = meta[k];
    const added = readLines(path.join(dir, "sims", id, "chat.jsonl")).slice((state.chats[id] ?? []).length);
    if (added.length) body.chat[id] = added;
  }
  const wasOpen = new Set(state.inbox.filter((i) => i.status === "open").map((i) => i.id));
  for (const i of readJson(path.join(dir, "inbox.json"), [])) if (i.status === "done" && wasOpen.has(i.id)) body.inboxClosed.push({ id: i.id, reply: i.reply ?? null });
  for (const name of ENGINE_DOCS) {
    const f = path.join(dir, name);
    const v = existsSync(f) ? readJson(f, null) : null;
    if (!sameJson(v, state.docs[name])) body.docs[name] = v;
  }
  // Files: what changed goes up, then SimSites hears what this run deleted.
  const local = engineFiles(dir);
  for (const [rel, size] of Object.entries(local)) {
    if (size > 4 * 1024 * 1024) continue;
    const buf = readFileSync(path.join(dir, rel));
    if (state.files[rel] !== sha1(buf)) await upload(p, rel, buf);
  }
  body.removedFiles = Object.keys(state.files).filter((rel) => /^(sims|references|style)\//.test(rel) && !(rel in local));
  const r = await studioFetch(`/api/projects/${p}/engine`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body), signal: AbortSignal.timeout(60000) });
  if (!r.ok) fail(`Saving to ${studioUrl()} failed: ${(await r.json().catch(() => ({}))).error ?? `HTTP ${r.status}`}.`);
}

/** One request through the engine: pull, run here, push. Answers like the server would. */
async function viaEngine(method, p, body, project) {
  const dir = designDirOf(project);
  mkdirSync(dir, { recursive: true });
  const st = await studioFetch(`/api/projects/${project}/engine`, { signal: AbortSignal.timeout(60000) });
  if (st.status === 401) fail(`Not signed in to ${studioUrl()}. Make a token in ${studioUrl()}/settings, then: simsites auth <token>`);
  if (!st.ok) fail(`Couldn't read ${project} from ${studioUrl()}: ${(await st.json().catch(() => ({}))).error ?? `HTTP ${st.status}`}`);
  const state = await st.json();
  pullState(dir, state);
  const { engine, server } = await loadEngine(path.dirname(dir));
  const res = await engine.handle(method, p, body);
  // Links the engine built point at its own local server: show SimSites' instead.
  const text = (await res.text()).split(server.url).join(studioUrl());
  if (res.ok) await pushState(project, dir, state);
  return new Response(text, { status: res.status, headers: { "content-type": "application/json" } });
}

/** studioFetch, except for the browser work SimSites hands to this machine. */
async function apiFetch(method, p, body, init) {
  const project = engineRequest(method, p, body);
  if (project && (await usesEngine()))
    // Not a network error: say what failed here instead of "SimSites isn't reachable".
    return viaEngine(method, p, body, project).catch((err) => {
      const msg = String(err?.message || err);
      if (process.env.SIMSITES_DEBUG) console.error(err?.stack || err);
      fail(
        `Rendering on this machine failed: ${msg.split("\n").slice(0, 6).join("\n")}${/missing dependencies|install-deps/i.test(msg) ? "\nOn Linux, install the browser's libraries once: sudo npx playwright@1.63.0 install-deps chromium" : ""}`,
      );
    });
  return studioFetch(p, init);
}

async function api(method, p, body, { timeoutMs = 30000, soft = false } = {}) {
  if (soft) {
    // Returns { error } instead of exiting, for loops that must report partial progress.
    try {
      const res = await apiFetch(method, p, body, { method, headers: body ? { "content-type": "application/json" } : {}, body: body ? JSON.stringify(body) : undefined, signal: AbortSignal.timeout(timeoutMs) });
      const data = await res.json().catch(() => ({}));
      return res.ok ? data : { error: data.error || `HTTP ${res.status}` };
    } catch (err) {
      return { error: err?.name === "TimeoutError" ? "SimSites did not answer in time" : "SimSites is not reachable" };
    }
  }
  let res;
  try {
    res = await apiFetch(method, p, body, {
      method,
      headers: body ? { "content-type": "application/json" } : {},
      body: body ? JSON.stringify(body) : undefined,
      signal: AbortSignal.timeout(timeoutMs),
    });
  } catch (err) {
    if (err?.name === "TimeoutError") fail(`SimSites did not answer in time (${p}). Try again in a moment.`);
    fail(`SimSites isn't reachable at ${studioUrl()}. Check your connection (or SIMSITES_URL).`);
  }
  const text = await res.text();
  let data;
  try {
    data = JSON.parse(text);
  } catch {
    data = { error: text.slice(0, 300) };
  }
  if (res.status === 401)
    fail(`${data.error || "Not signed in."} Make a new token on ${studioUrl()} ("Create token and copy command", or Settings → CLI tokens) and paste the line it copies into Claude Code.`);
  // A feature SimSites doesn't know (put away, someone else's, or a typo): say which, and where to look.
  if (res.status === 404 && p.endsWith("/restore")) fail(`SimSites has no feature "${p.split("/")[3]}" of yours to bring back. simsites list shows this repo's features.`);
  const missing = res.status === 404 && data.error === "Not found" && p.match(/^\/api\/projects\/([a-z0-9][a-z0-9-]*)/)?.[1];
  if (missing)
    fail(`SimSites has no feature "${missing}" you can open. If it was put away (simsites cancel), bring it back with simsites restore --project ${missing}. Otherwise it's someone else's: simsites list shows this repo's features.`);
  if (!res.ok) fail(data.error || `HTTP ${res.status}`);
  return data;
}

async function studioUp() {
  try {
    const r = await studioFetch("/api/projects", { signal: AbortSignal.timeout(4000) });
    return r.ok;
  } catch {
    return false;
  }
}

let healthCache;
/** What the SimSites this CLI talks to says about itself (null when it doesn't answer). */
async function health() {
  if (healthCache === undefined)
    healthCache = await studioFetch("/api/health", { signal: AbortSignal.timeout(8000) })
      .then((r) => (r.ok ? r.json() : null))
      .catch(() => null);
  return healthCache;
}

/**
 * The hosted SimSites — the product: features live there, and this CLI keeps each feature's design folder in step
 * with it. (A Studio without cloud storage, for developing SimSites itself, reads the folder directly.)
 */
async function isHosted() {
  return !!(await health())?.hosted;
}

/** Before starting work: SimSites answers, and this computer is signed in to it. */
async function ensureStudio() {
  const h = await health();
  if (!h) fail(`SimSites isn't reachable at ${studioUrl()}. Check your connection (or SIMSITES_URL).`);
  if (!h.features?.includes("repo-0.5")) fail(`The SimSites at ${studioUrl()} is older than this plugin. Update it, or point the CLI at another one (simsites auth <token> --url …).`);
  if (h.hosted && !studioToken())
    fail(`Sign in to SimSites first: open ${studioUrl()}, click "Create token and copy command" (or Settings → CLI tokens), and paste the line it copies into Claude Code.`);
}

// ---- git: what links a feature to its repo, branch and commits on GitHub -------------------------------------------

function git(...args) {
  try {
    return execFileSync("git", args, { cwd: ROOT, stdio: ["ignore", "pipe", "ignore"] }).toString().trim();
  } catch {
    return null;
  }
}

/**
 * The repo's remote and branch, and the commit verify replays: in CI, SIMSITES_SHA (a pull request's head commit —
 * GITHUB_SHA is the merge commit there). "dirty": changes to the app not committed yet (.simsites/ doesn't count).
 */
function gitInfo() {
  const status = git("status", "--porcelain", "--untracked-files=no", "--", ".", ":(exclude).simsites");
  return {
    remote: git("remote", "get-url", "origin"),
    branch: process.env.SIMSITES_BRANCH || git("branch", "--show-current") || null,
    sha: process.env.SIMSITES_SHA || git("rev-parse", "HEAD"),
    dirty: process.env.SIMSITES_SHA ? false : status === null ? false : status.length > 0,
  };
}

// ---- the design folder on SimSites ---------------------------------------------------------------------------------

const designDirOf = (p) => path.join(ROOT, ".simsites", "design", p);
const sha1 = (buf) => createHash("sha1").update(buf).digest("hex");

/**
 * Files of the design folder that live on SimSites: scenes and takes, style, the app's screenshots and notes. Not
 * what look writes (look/, history/ — they come down after a look), nor this CLI's own state.
 */
// Claude's own before/after sheets, made again at every look: nothing on SimSites shows them, so they stay here.
const LOCAL_ONLY = /^sims\/[^/]+\/look\/(compare|previous)(-mobile)?\.jpg$/;

const SYNCED = (rel) =>
  !LOCAL_ONLY.test(rel) &&
  /^(sims\/[a-z0-9][a-z0-9-]*\/[^/]+|style\/.+|references\/[^/]+|[\w.-]+\.(html|css))$/.test(rel) &&
  !rel.split("/").some((part) => part.startsWith(".")) &&
  !/^sims\/[^/]+\/(looked\.html|meta\.json|chat\.jsonl)$/.test(rel) &&
  rel !== "references/capture.json";

function walkFiles(dir, base = "") {
  const out = [];
  let entries = [];
  try {
    entries = readdirSync(path.join(dir, base), { withFileTypes: true });
  } catch {
    return out;
  }
  for (const e of entries) {
    const rel = base ? `${base}/${e.name}` : e.name;
    if (e.isDirectory()) out.push(...walkFiles(dir, rel));
    else if (e.isFile()) out.push(rel);
  }
  return out;
}

const encodeRel = (rel) => rel.split("/").map(encodeURIComponent).join("/");

/** A feature file from SimSites (null when it isn't there). */
async function download(p, rel) {
  const res = await studioFetch(`/ws/${p}/${encodeRel(rel)}`, { signal: AbortSignal.timeout(60000) }).catch(() => null);
  return res?.ok ? Buffer.from(await res.arrayBuffer()) : null;
}

async function upload(p, rel, body) {
  const res = await studioFetch(`/api/projects/${p}/files/${encodeRel(rel)}`, { method: "PUT", body, signal: AbortSignal.timeout(60000) }).catch((err) => ({
    ok: false,
    status: 0,
    json: async () => ({ error: String(err) }),
  }));
  if (!res.ok) fail(`Uploading ${rel} failed: ${(await res.json().catch(() => ({}))).error ?? `HTTP ${res.status}`}`);
}

/**
 * Bring the design folder and the feature on SimSites in step, both ways: a file changed here goes up, a file changed
 * there (an undo, a take kept on the watch page) comes down. When both changed, this folder wins — Claude is editing
 * it. usecases.json and plan.json go up as they are. .sync.json remembers what both sides had last time.
 */
async function syncDesign(p, { quiet = false } = {}) {
  const dir = designDirOf(p);
  mkdirSync(dir, { recursive: true });
  const stateFile = path.join(dir, ".sync.json");
  const last = readJson(stateFile, {});
  const remote = await api("GET", `/api/projects/${p}/sync`);
  const there = Object.fromEntries(Object.entries(remote.files ?? {}).filter(([rel]) => SYNCED(rel)));
  const here = {};
  for (const rel of walkFiles(dir)) if (SYNCED(rel)) here[rel] = sha1(readFileSync(path.join(dir, rel)));
  const next = {};
  const up = [];
  const down = [];
  const both = [];
  for (const rel of new Set([...Object.keys(here), ...Object.keys(there)])) {
    const l = here[rel];
    const r = there[rel];
    const b = last[rel];
    if (l === r) next[rel] = l;
    else if (l && r && l !== b && r !== b) (both.push(rel), up.push(rel));
    else if (l && l !== b) up.push(rel);
    else if (r && r !== b) down.push(rel);
    else if (l) next[rel] = l; // removed there, unchanged here: keep it
  }
  // A request to the hosted SimSites carries at most ~4.5 MB: a bigger file stays here only (said once), instead of
  // failing every command after it. Six at a time.
  const tooBig = [];
  for (let i = 0; i < up.length; i += 6)
    await Promise.all(
      up.slice(i, i + 6).map(async (rel) => {
        const body = readFileSync(path.join(dir, rel));
        if (body.length > 4 * 1024 * 1024) tooBig.push(rel);
        else await upload(p, rel, body);
        next[rel] = sha1(body);
      }),
    );
  if (tooBig.length && !JSON_OUT) progress(`too big for SimSites (over 4 MB), kept on this computer only: ${tooBig.join(", ")}`);
  for (const rel of down) {
    const body = await download(p, rel);
    if (!body) continue;
    mkdirSync(path.dirname(path.join(dir, rel)), { recursive: true });
    writeFileSync(path.join(dir, rel), body);
    next[rel] = sha1(body);
  }
  // The sims' definitions and the plan are Claude's: this folder's copy is the one that counts.
  const useCases = readJson(path.join(dir, "usecases.json"), undefined);
  const plan = readJson(path.join(dir, "plan.json"), undefined);
  const { remote: gitRemote, branch } = gitInfo();
  await api("POST", `/api/projects/${p}/sync`, {
    ...(useCases !== undefined ? { useCases } : {}),
    ...(plan !== undefined ? { plan } : {}),
    git: { remote: gitRemote, branch },
  });
  if (useCases === undefined && plan === undefined && remote.useCases?.length) {
    // Another computer designed it: start from what SimSites has.
    writeFileSync(path.join(dir, "usecases.json"), JSON.stringify(remote.useCases, null, 2) + "\n");
    if (remote.plan) writeFileSync(path.join(dir, "plan.json"), JSON.stringify(remote.plan, null, 2) + "\n");
  }
  writeFileSync(stateFile, JSON.stringify(next, null, 2) + "\n");
  if (!quiet && !JSON_OUT && both.length) progress(`changed both here and on SimSites, kept this folder's: ${both.join(", ")}`);
  return { up, down, capture: remote.capture ?? null };
}

/**
 * An answer from SimSites names files by their place in the feature (sims/x/look/storyboard.jpg): download each one
 * into the design folder and answer with the local path instead, so Claude reads them where it always does.
 */
async function localize(p, value) {
  const dir = designDirOf(p);
  const isFile = (v) => typeof v === "string" && /^(sims|references)\/[^\s]+\.[a-z0-9]{2,5}$/i.test(v) && !v.includes("..");
  const wanted = new Set();
  const collect = (v) => {
    if (isFile(v)) wanted.add(v);
    else if (Array.isArray(v)) v.forEach(collect);
    else if (v && typeof v === "object") Object.values(v).forEach(collect);
  };
  collect(value);
  // The report of a look sits next to its frames: Claude reads it too.
  for (const f of [...wanted]) if (/^sims\/[^/]+\/look\//.test(f)) wanted.add(f.replace(/look\/.*$/, "look/report.json"));
  const list = [...wanted];
  for (let i = 0; i < list.length; i += 6)
    await Promise.all(
      list.slice(i, i + 6).map(async (rel) => {
        const body = await download(p, rel);
        if (!body) return;
        mkdirSync(path.dirname(path.join(dir, rel)), { recursive: true });
        writeFileSync(path.join(dir, rel), body);
      }),
    );
  // Look's folders are whole again: frames of an older version that aren't in this answer go.
  const looks = new Set(list.filter((f) => /^sims\/[^/]+\/look\/\d\d-/.test(f)).map((f) => path.dirname(f)));
  for (const d of looks)
    for (const f of walkFiles(path.join(dir, d))) if (/^(m-)?\d\d-.*\.jpg$/.test(f) && !wanted.has(`${d}/${f}`)) rmSafe(path.join(dir, d, f));
  const map = (v) => (isFile(v) ? path.join(dir, v) : Array.isArray(v) ? v.map(map) : v && typeof v === "object" ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, map(x)])) : v);
  const out = map(value);
  // look's own folder (sims/x/look) has no extension: it's a folder.
  if (out && typeof out.dir === "string" && /^sims\//.test(out.dir)) out.dir = path.join(dir, out.dir);
  return out;
}

function rmSafe(file) {
  try {
    rmSync(file, { force: true });
  } catch {}
}

/**
 * Playwright, for capturing the app and verifying the build on this machine: from ~/.simsites/runner, installed there
 * the first time (SIMSITES_PLAYWRIGHT_DIR: a folder that already has it). Its browser too, unless one is installed.
 */
async function loadPlaywright() {
  const { createRequire } = await import("node:module");
  const runner = path.join(HOME_DIR, "runner");
  const from = (dir) => {
    try {
      return createRequire(path.join(dir, "package.json"))("playwright");
    } catch {
      return null;
    }
  };
  let pw = (process.env.SIMSITES_PLAYWRIGHT_DIR && from(process.env.SIMSITES_PLAYWRIGHT_DIR)) || from(runner);
  if (!pw) {
    progress("Installing Playwright, which SimSites uses to capture your app and verify the build (once) …");
    mkdirSync(runner, { recursive: true });
    if (!existsSync(path.join(runner, "package.json"))) writeFileSync(path.join(runner, "package.json"), '{ "private": true }\n');
    try {
      // Windows: npm is npm.cmd, which Node only runs through a shell.
      execFileSync(process.platform === "win32" ? "npm.cmd" : "npm", ["install", "--no-audit", "--no-fund", "--loglevel=error", "playwright@1.63.0"], {
        cwd: runner,
        stdio: ["ignore", "ignore", "inherit"],
        shell: process.platform === "win32",
      });
    } catch (err) {
      if (err?.code === "ENOENT") fail("npm wasn't found (it comes with Node.js). Install Node 20+ from nodejs.org, or set SIMSITES_PLAYWRIGHT_DIR to a folder where playwright@1.63.0 is installed.");
      fail(`Installing Playwright failed (${err?.message?.split("\n")[0] ?? err}). Install it yourself: in the folder ${runner}, run npm install playwright@1.63.0`);
    }
    pw = from(runner);
    if (!pw) fail(`Playwright isn't loadable from ${runner}.`);
  }
  const { findInstalledChromium } = await import(pathToFileURL(path.join(PLUGIN_DIR, "runner", "chromium.mjs")).href);
  let own = null;
  try {
    own = pw.chromium.executablePath();
  } catch {}
  if (!(own && existsSync(own)) && !findInstalledChromium()) {
    progress("Downloading the browser Playwright uses (once) …");
    try {
      execFileSync(process.execPath, [createRequire(path.join(runner, "package.json")).resolve("playwright/cli.js"), "install", "chromium"], { stdio: ["ignore", "ignore", "inherit"] });
    } catch {
      fail(
        `Downloading Chromium failed. Run: npx playwright@1.63.0 install chromium${process.platform === "linux" ? " (and on Linux, if it says libraries are missing: sudo npx playwright@1.63.0 install-deps chromium)" : ""}`,
      );
    }
  }
  return pw;
}

/** Capture the running app into the design folder's references/ and put the screens on SimSites. */
async function captureLocal(p, { routes, add = null, brief = "" } = {}) {
  const cfg = repoConfig();
  const { chromium } = await loadPlaywright();
  const { captureScreens, routesNamedIn } = await import(pathToFileURL(path.join(PLUGIN_DIR, "runner", "capture.mjs")).href);
  const repo = { path: ROOT, devUrl: cfg.devUrl, routes: cfg.routes ?? ["/"] };
  const authFile = path.join(ROOT, ".simsites", "auth.json");
  const before = add ? ((await syncDesign(p, { quiet: true })).capture ?? null) : null;
  const capture = await captureScreens({
    chromium,
    dir: path.join(designDirOf(p), "references"),
    repo,
    routes: add ?? [...new Set([...(routes ?? repo.routes), ...(await routesNamedIn(brief, repo))])],
    storageState: existsSync(authFile) ? authFile : undefined,
    add: !!add,
    before,
    log: (x) => !JSON_OUT && progress(x),
  });
  await syncDesign(p, { quiet: true });
  await api("POST", `/api/projects/${p}/sync`, { capture });
  return capture;
}

// ---- repo detection --------------------------------------------------------------------------

const frameworkOf = (pkg) => {
  const deps = { ...(pkg?.dependencies ?? {}), ...(pkg?.devDependencies ?? {}) };
  return deps.next ? "next" : deps.vite ? "vite" : deps["react-scripts"] ? "cra" : deps.astro ? "astro" : deps["@sveltejs/kit"] ? "sveltekit" : deps.nuxt ? "nuxt" : null;
};

/** The web app's folder: the repo itself, or in a monorepo (apps/web, apps/site, …) the first app with a web framework. */
function webAppDir() {
  if (frameworkOf(readJson(path.join(ROOT, "package.json"), null))) return ROOT;
  for (const group of ["apps", "packages"]) {
    let names = [];
    try {
      names = readdirSync(path.join(ROOT, group));
    } catch {
      continue;
    }
    const rank = (n) => (["web", "app", "frontend", "site", "www", "dashboard"].includes(n) ? 0 : 1);
    for (const n of names.sort((a, b) => rank(a) - rank(b))) {
      if (frameworkOf(readJson(path.join(ROOT, group, n, "package.json"), null))) return path.join(ROOT, group, n);
    }
  }
  return ROOT;
}
const APP_DIR = webAppDir();

function detectDev() {
  const pkg = readJson(path.join(ROOT, "package.json"), null);
  const app = APP_DIR === ROOT ? pkg : readJson(path.join(APP_DIR, "package.json"), null);
  const scripts = pkg?.scripts ?? {};
  const dev = scripts.dev || scripts.start || "";
  const framework = frameworkOf(app);
  // The port is in the web app's own dev script (a monorepo's root script just runs turbo/nx).
  const appDev = app?.scripts?.dev || app?.scripts?.start || dev;
  const m = appDev.match(/(?:--port|-p)[ =](\d{2,5})/) || appDev.match(/PORT=(\d{2,5})/);
  const port = m ? m[1] : { next: "3000", vite: "5173", cra: "3000", astro: "4321", sveltekit: "5173", nuxt: "3000" }[framework] ?? "3000";
  const pm = existsSync(path.join(ROOT, "pnpm-lock.yaml")) ? "pnpm" : existsSync(path.join(ROOT, "yarn.lock")) ? "yarn" : existsSync(path.join(ROOT, "bun.lockb")) || existsSync(path.join(ROOT, "bun.lock")) ? "bun" : "npm";
  return { framework, devUrl: `http://localhost:${port}`, devCommand: dev ? `${pm} run ${scripts.dev ? "dev" : "start"}` : null };
}

/** The detected dev URL if it answers, else the first common local port serving an HTML page (or null). */
async function findRunningDevServer(detected) {
  const ports = [...new Set([new URL(detected).port, "3000", "3001", "3002", "3003", "5173", "5174", "4321", "8080", "8000"])];
  // Never the Studio this CLI talks to (its port may be the one the app's package.json names).
  const studioPort = new URL(studioUrl()).port;
  for (const port of ports) {
    if (port === studioPort) continue;
    try {
      const res = await fetch(`http://localhost:${port}/`, { signal: AbortSignal.timeout(1500) });
      // A page behind a sign-in (401, a redirect to /login) or a missing / is still the app.
      if (res.status < 500 && (res.headers.get("content-type") ?? "").includes("text/html")) return `http://localhost:${port}`;
    } catch {}
  }
  return null;
}

/** Static routes of a Next.js app (app router or pages router), at most 8. */
function detectRoutes() {
  const routes = new Set();
  const walk = (dir, base, router) => {
    let entries = [];
    try {
      entries = readdirSync(dir);
    } catch {
      return;
    }
    for (const e of entries) {
      const full = path.join(dir, e);
      if (e === "node_modules" || e.startsWith(".") || e === "api") continue;
      let st;
      try {
        st = statSync(full);
      } catch {
        continue;
      }
      if (st.isDirectory()) {
        if (/^\[.*\]$/.test(e) || e.startsWith("@") || e.startsWith("_")) continue;
        if (router === "remix") {
          // Remix folder routes: "settings.team/route.tsx" → /settings/team; "$id" folders are dynamic.
          if (!/[$]/.test(e) && readdirSync(full).some((f) => /^route\.(t|j)sx?$/.test(f))) routes.add("/" + e.replace(/\._index$/, "").replace(/\./g, "/"));
          continue;
        }
        const seg = /^\(.*\)$/.test(e) ? "" : "/" + e;
        walk(full, base + seg, router);
      } else if (router === "app" && /^page\.(t|j)sx?$/.test(e)) routes.add(base || "/");
      else if (router === "svelte" && /^\+page\.svelte$/.test(e)) routes.add(base || "/");
      else if (router === "astro" && /\.(astro|md|mdx)$/.test(e) && !/^\[/.test(e)) {
        const name = e.replace(/\.(astro|mdx?)$/, "");
        routes.add(name === "index" ? base || "/" : `${base}/${name}`);
      } else if (router === "remix" && /\.(t|j)sx?$/.test(e) && !/[$]/.test(e) && !/^_/.test(e) && !/\.(server|client)\./.test(e)) {
        // Remix flat routes: "settings.team.tsx" → /settings/team, "_index.tsx" → / (skipped above as "_"), "$id" is dynamic.
        const name = e.replace(/\.(t|j)sx?$/, "").replace(/\._index$/, "").replace(/\./g, "/");
        routes.add(name === "index" ? "/" : `/${name}`);
      }
      else if (router === "pages" && /\.(t|j)sx?$/.test(e) && !/^_/.test(e) && !/^\[/.test(e)) {
        const name = e.replace(/\.(t|j)sx?$/, "");
        routes.add(name === "index" ? base || "/" : `${base}/${name}`);
      }
    }
  };
  for (const d of ["app", "src/app"]) if (existsSync(path.join(APP_DIR, d))) walk(path.join(APP_DIR, d), "", "app");
  for (const d of ["pages", "src/pages"]) {
    if (!existsSync(path.join(APP_DIR, d))) continue;
    const astro = existsSync(path.join(APP_DIR, "astro.config.mjs")) || existsSync(path.join(APP_DIR, "astro.config.ts"));
    walk(path.join(APP_DIR, d), "", astro ? "astro" : "pages");
  }
  if (existsSync(path.join(APP_DIR, "src/routes"))) walk(path.join(APP_DIR, "src/routes"), "", "svelte");
  if (existsSync(path.join(APP_DIR, "app/routes"))) {
    routes.add("/");
    walk(path.join(APP_DIR, "app/routes"), "", "remix");
  }
  const list = [...routes].sort((a, b) => a.split("/").length - b.split("/").length || a.localeCompare(b));
  return list.length ? list.slice(0, 8) : ["/"];
}

/**
 * Keep the Studio's run output and the saved session out of git; hand-offs (films, frames, BUILD.md) are meant to be
 * committed — they're the regression suite. Adds missing lines to an existing .simsites/.gitignore.
 */
function ensureIgnored() {
  const gi = path.join(ROOT, ".simsites", ".gitignore");
  mkdirSync(path.dirname(gi), { recursive: true });
  const have = existsSync(gi) ? readFileSync(gi, "utf8") : "";
  const missing = ["*/verify/", "*/VERIFY.md", "*/verify-report.json", "auth.json", ".hook-state.json", "design/*/sims/*/look/", "design/*/sims/*/history/", "design/*/sims/*/looked.html", "design/*/.sync.json", "design/*/verify/"].filter((l) => !have.split("\n").includes(l));
  if (missing.length) writeFileSync(gi, have + (have && !have.endsWith("\n") ? "\n" : "") + missing.join("\n") + "\n");
}

/** Same-site links on the running app's home page, e.g. ["/", "/pricing", "/settings"] (max 8). */
async function linkedRoutes(devUrl, fallback) {
  try {
    const html = await (await fetch(devUrl.replace(/\/+$/, "") + "/", { signal: AbortSignal.timeout(5000) })).text();
    const found = new Set(["/"]);
    for (const m of html.matchAll(/href=["'](\/[a-z0-9][^"'#?\s]*)["']/gi)) {
      const p = m[1].replace(/\/+$/, "");
      if (!/\.[a-z0-9]{2,5}$/i.test(p) && !/^\/(_next|static|assets|api|cdn-cgi)\b/.test(p)) found.add(p);
    }
    return [...found].slice(0, 8);
  } catch {
    return fallback;
  }
}

// ---- formatting ------------------------------------------------------------------------------

const STATUS = {
  empty: c.dim("waiting"),
  generating: c.blue("generating"),
  draft: "draft",
  changes: c.blue("changing"),
  approved: c.green("approved"),
  error: c.red("error"),
};

function printSummary(s) {
  out(`${c.bold(s.project.title)} ${c.dim(`(${s.project.id})`)}`);
  if (s.project.repo) out(c.dim(`repo ${s.project.repo.path} · app ${s.project.repo.devUrl}`));
  out(`watch: ${s.watchUrl ?? s.reviewUrl}${s.listening ? c.dim("  (Claude Code is listening)") : ""}`);
  out("");
  if (!s.useCases.length) out(c.dim("No sims yet."));
  for (const u of s.useCases) {
    const extra = [u.error ? c.red(u.error.slice(0, 80)) : ""].filter(Boolean).join(" ");
    out(`  ${(STATUS[u.status] ?? u.status).padEnd(20)} ${u.title} ${c.dim(u.id)} ${extra}`);
  }
  if (s.plan) out(c.dim(`\n${s.plan.scope} feature — ${s.plan.reason}`));
  if (s.assumptions?.length) out(c.dim(`\n${s.assumptions.length} decisions and assumptions — change them on the watch page (Details)`));
  if (s.inbox?.length) out(c.yellow(`\n${s.inbox.length} comment${s.inbox.length === 1 ? "" : "s"} from the watch page waiting — simsites inbox`));
}

